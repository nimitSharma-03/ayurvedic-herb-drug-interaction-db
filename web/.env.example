# Where the backend is. Read in the browser as well as on the server, so it
# must be a URL the reader's browser can reach, not an internal hostname.
# Defaults to http://127.0.0.1:8000 when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# No keys belong in this file. The backend needs none, and nothing in this app
# sends an Authorization header.
